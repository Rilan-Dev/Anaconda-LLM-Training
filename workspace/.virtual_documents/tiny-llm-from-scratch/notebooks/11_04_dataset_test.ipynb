from pathlib import Path
import sys

PROJECT_ROOT = Path("/workspace/tiny-llm-from-scratch")

sys.path.append(str(PROJECT_ROOT))

print(PROJECT_ROOT)


from training.dataset import TinyDataset


dataset = TinyDataset.load(
    PROJECT_ROOT /
    "datasets/processed/split/train.json"
)


len(dataset)


dataset.summary()


samples = dataset.head(3)

for i, sample in enumerate(samples, start=1):

    print("="*80)

    print(f"Sample {i}")

    print("-"*80)

    print("Instruction:\n")

    print(sample.instruction[:300])

    print()

    print("Response:\n")

    print(sample.response[:500])

    print()


samples = dataset.tail(3)

for i, sample in enumerate(samples, start=1):

    print("="*80)

    print(f"Sample {i}")

    print("-"*80)

    print("Instruction:\n")

    print(sample.instruction[:300])

    print()

    print("Response:\n")

    print(sample.response[:500])

    print()


results = dataset.search("python")

print("Results:", len(results))


if results:

    print("="*80)

    print("Instruction")

    print("-"*80)

    print(results[0].instruction)

    print()

    print("="*80)

    print("Response")

    print("-"*80)

    print(results[0].response[:1000])


errors = dataset.validate()

print(errors)


stats = dataset.statistics()

stats


dataset.export_json(

    PROJECT_ROOT /

    "datasets/processed/test_export.json"

)


new_dataset = TinyDataset.load(

    PROJECT_ROOT /

    "datasets/processed/test_export.json"

)

print(len(new_dataset))


print("="*60)

print("TinyLLM Dataset Module")

print("="*60)

print("Dataset Loaded        :", len(dataset))

print("Validation Errors     :", len(errors))

print("Search Working        :", len(results) > 0)

print("Export Working        :", len(new_dataset) == len(dataset))

print()

if len(errors) == 0:

    print("★★★★★ Dataset Module PASSED")

else:

    print("Dataset Module FAILED")

